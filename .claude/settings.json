{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "tutor-agent",
  "permissions": {
    "allow": [
      "Edit(/.claude/agent-memory-local/**)"
    ],
    "deny": [
      "Edit(**/*.vhd)",
      "Edit(**/*.vhdl)",
      "Edit(**/*.xdc)",
      "Edit(**/*.yml)",
      "Edit(**/Makefile)",
      "Edit(**/*.mk)",
      "Edit(**/*.tcl)",
      "Edit(**/*.ps1)",
      "Edit(/CLAUDE.md)",
      "Edit(/.gitignore)",
      "Edit(/.github/**)",
      "Edit(/.vscode/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "FileChanged": [
      {
        "matcher": "sim_result.txt",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "asyncRewake": true,
            "timeout": 30,
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\sim-passed.ps1\""
          }
        ]
      }
    ]
  }
}
